logs/**/*.class

# Backup copies of CSVs made before edits (Git keeps history from now on)
*.bak

# Python caches
__pycache__/
*.pyc

# Python virtual environment (recreate with: python -m venv --system-site-packages .venv; pip install -r requirements.txt)
.venv/
